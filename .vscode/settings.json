{
  "eslint.options": {
    "overrideConfigFile": ".config/eslint.config.ts"
  },
  "eslint.workingDirectories": [
    "."
  ],
  "files.associations": {
    "**/content/**/*.md": "mdc"
  },
  "files.exclude": {
    "content/{.vscode,node_modules}": true
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "material-icon-theme.folders.associations": {
    "garden": "images",
    "novel": "docs"
  },
  "vue.server.includeLanguages": [
    "mdc",
    "vue"
  ]
}

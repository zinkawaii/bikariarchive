{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "nuxt dev --no-qr",
    "build": "nuxt build",
    "prebuild": "pnpm run task:jnm",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "stylelint": "stylelint **/*.{vue,scss}",

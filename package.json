{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "nuxt dev --no-qr",
    "build": "nuxt build",
    "prebuild": "pnpm \"/^task:(?:bangumi|jnm)$/\" --parallel",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "stylelint": "stylelint **/*.{vue,scss}",
    "git:stash": "git add -A && git stash",
    "git:stash/pop": "git stash pop && git reset",
    "new": "pnpm --filter @bikari/article new",
    "task:article": "node scripts/article.ts",
    "task:article/dev": "cross-env NODE_ENV=\"development\" node --watch scripts/article.ts",
    "task:bangumi": "node scripts/bangumi.ts",
    "task:feed": "node scripts/feed.ts",
    "task:jnm": "node scripts/jnm.ts",
    "task:svgo": "svgo public/image/favicon.svg --pretty"
  },
  "dependencies": {
    "@kabeep/lunar-date-fns": "catalog:utils",
    "@vueuse/core": "catalog:vue",
    "@vueuse/router": "catalog:vue",

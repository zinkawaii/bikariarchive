{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "prepare": "nuxt-seo-utils icons --source image/favicon.svg",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "stylelint": "stylelint **/*.{vue,css}",
    "git:stash": "git add -A && git stash",
    "git:stash/pop": "git stash pop && git reset",
    "new": "pnpm --filter @bikari/article new",
    "task:article": "unrun scripts/article.ts",
    "task:article/dev": "NODE_ENV=\"development\" unrun --watch scripts/article.ts",
    "task:feed": "unrun scripts/feed.ts",
    "task:svgo": "pnpx svgo public/image/favicon.svg --pretty"
  },
  "dependencies": {
    "@shikijs/transformers": "catalog:utils",

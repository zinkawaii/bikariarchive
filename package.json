    "date-fns": "catalog:utils",
    "github-slugger": "catalog:utils",
    "hookable": "catalog:utils",
    "katex": "catalog:utils",
    "pinia": "catalog:vue",
    "pinia-plugin-persistedstate": "catalog:vue",
    "plain-shiki": "catalog:utils",
    "shiki": "catalog:utils",
    "uqr": "catalog:utils",
    "vue": "catalog:vue",
    "vue-router": "catalog:vue"
  },
  "devDependencies": {
    "@iconify-json/fa7-brands": "catalog:iconify",
    "@iconify-json/fa7-solid": "catalog:iconify",
    "@mdzjs/config": "catalog:markdown",
    "@nuxt/devtools": "catalog:nuxt",
    "@nuxt/eslint": "catalog:nuxt",
    "@nuxt/fonts": "catalog:nuxt",
    "@nuxt/icon": "catalog:nuxt",
    "@nuxt/image": "catalog:nuxt",
    "@nuxtjs/seo": "catalog:nuxt",
    "@pinia/nuxt": "catalog:nuxt",
    "@types/wicg-file-system-access": "catalog:types",
    "@vitejs/plugin-vue": "catalog:vue",
    "@vueuse/nuxt": "catalog:nuxt",
    "@zinkawaii/eslint-config": "catalog:lint",
    "@zinkawaii/stylelint-config": "catalog:lint",

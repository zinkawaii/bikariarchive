    "@pinia/nuxt": "^0.5.1",
    "dayjs": "^1.11.10",
    "dompurify": "^3.0.9",
    "lunisolar": "^2.5.0",
    "marked": "^12.0.1",
    "prismjs": "^1.29.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },

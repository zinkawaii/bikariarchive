{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "deploy": "pm2 restart .output/server/index.mjs",
    "dev": "nuxi dev --no-qr",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation\" nuxi build",
    "prepare": "nuxi prepare",
    "preview": "nuxi preview",
    "eslint": "eslint .",
    "stylelint": "stylelint **/*.{vue,scss}",
    "git:stash": "git add -A && git stash",
    "git:stash/pop": "git stash pop && git reset",
    "task:abbrlink": "cd scripts && node --watch abbrlink.js",
    "task:bangumi": "cd scripts && node --watch bangumi.js",
    "task:build": "pnpm run git:stash && pnpm run fix:sharp && pnpm run build && pnpm run git:stash/pop",
    "task:deploy": "cd scripts && node deploy.js",
    "task:process": "node scripts/process.js",
    "task:process/dev": "cross-env NODE_ENV=\"development\" node --watch scripts/process.js",
    "fix:sharp": "npm rebuild --arch=x64 --platform=linux sharp"
  },
  "dependencies": {
    "@vueuse/core": "^11.1.0",
    "@vueuse/router": "^11.1.0",
    "crypto-es": "^2.1.0",
    "dayjs": "^1.11.13",

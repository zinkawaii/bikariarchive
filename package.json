    "entities": "catalog:utils",
    "github-slugger": "catalog:utils",
    "katex": "catalog:utils",
    "pinia": "catalog:vue",
    "pinia-plugin-persistedstate": "catalog:vue",
    "plain-shiki": "catalog:utils",
    "shiki": "catalog:utils",
    "temporal-polyfill": "catalog:utils",
    "ufo": "catalog:utils",
    "uqr": "catalog:utils",
    "vue": "catalog:vue",
    "vue-router": "catalog:vue"
  },
  "devDependencies": {
    "@bikariya/image-viewer": "catalog:nuxt",

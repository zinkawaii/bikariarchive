    "glob": "^11.0.0",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.9.15",
    "nuxt": "^3.13.2",
    "nuxt-mongoose": "^1.0.6",
    "sass": "^1.79.1",
    "ssh2-sftp-client": "^11.0.0",
    "stylelint": "^16.9.0",
    "tar": "^7.4.3",
    "tsup": "^8.3.0",
    "yaml": "^2.5.1"

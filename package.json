{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "deploy": "pm2 restart .output/server/index.mjs",
    "dev": "nuxi dev --no-qr",
    "build": "nuxi build",
    "prepare": "nuxi prepare",
    "preview": "nuxi preview",
    "tscheck": "vue-tsc",
    "eslint": "eslint .",
    "stylelint": "stylelint **/*.{vue,scss}",
    "git:stash": "git add -A && git stash",
    "git:stash/pop": "git stash pop && git reset",
    "task:article": "node scripts/article.js",
    "task:article/dev": "cross-env NODE_ENV=\"development\" node --watch scripts/article.js",
    "task:bangumi": "cd scripts && node --watch bangumi.js",
    "task:build": "pnpm run git:stash && pnpm run fix:sharp && pnpm run build && pnpm run git:stash/pop",
    "task:deploy": "cd scripts && node deploy.js",
    "task:jnm": "cd scripts && node jnm.js",
    "fix:sharp": "npm rebuild --arch=x64 --platform=linux sharp"
  },
  "dependencies": {
    "@vueuse/core": "catalog:frontend",
    "@vueuse/router": "catalog:frontend",
    "animejs": "catalog:frontend",
    "crypto-es": "catalog:backend",
    "date-fns": "catalog:frontend",
    "github-slugger": "catalog:frontend",
    "hookable": "catalog:backend",
    "katex": "catalog:frontend",
    "lunisolar": "catalog:frontend",
    "pinia": "catalog:frontend",
    "pinia-plugin-persistedstate": "catalog:frontend",
    "plain-shiki": "catalog:frontend",
    "shiki": "catalog:frontend",
    "uqr": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-router": "catalog:frontend"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@iconify-json/fa6-solid": "catalog:backend",
    "@inquirer/prompts": "catalog:backend",
    "@kikiutils/nuxt-session": "catalog:backend",
    "@mdzjs/config": "catalog:markdown",
    "@nuxt/devtools": "catalog:backend",
    "@nuxt/fonts": "catalog:backend",
    "@nuxt/icon": "catalog:backend",
    "@nuxt/image": "catalog:backend",
    "@nuxtjs/seo": "catalog:backend",
    "@pinia/nuxt": "catalog:backend",
    "@types/fs-extra": "catalog:types",
    "@types/nodemailer": "catalog:types",
    "@types/ssh2-sftp-client": "catalog:types",
    "@types/wicg-file-system-access": "catalog:types",
    "@vitejs/plugin-vue": "catalog:backend",
    "@vue-email/render": "catalog:backend",
    "@vueuse/nuxt": "catalog:backend",
    "@zinkawaii/eslint-config": "catalog:lint",
    "@zinkawaii/nuxt-shiki": "catalog:backend",
    "@zinkawaii/stylelint-config": "catalog:lint",
    "arktype": "catalog:backend",
    "chokidar": "catalog:backend",
    "cn-font-split": "catalog:backend",
    "consola": "catalog:backend",
    "croner": "catalog:backend",
